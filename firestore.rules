// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /maintenance_tickets/{ticketId} {
      // Allow authenticated users to read tickets and create new ones
      allow read, create: if request.auth != null;
      // Allow updates to status and technician notes (admin-like behavior)
      // For now, let's allow all authenticated users to update for simplicity,
      // Or we can add a check for 'admin' role if needed.
      allow update: if request.auth != null;
      allow delete: if false; // Prevention of accidental deletions
    }
  }
}

// storage.rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /maintenance_images/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 5 * 1024 * 1024; // Limit to 5MB
    }
  }
}
